.tabs {
  display: flex;
  background-color: #ffffff;
  padding: 0 12rpx;
  position: sticky;
  top: 0;
  z-index: 10;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #6b7075;
  position: relative;
}

.tab-on {
  color: #2f7d32;
  font-weight: 600;
}

.tab-on::after {
  content: "";
  position: absolute;
  left: 50%;
  bottom: 6rpx;
  transform: translateX(-50%);
  width: 40rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background-color: #2f7d32;
}

/* -------- 条目 -------- */
.item {
  margin: 20rpx 24rpx 0;
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 20rpx;
}

.item-main {
  display: flex;
  position: relative;
}

.item-cover {
  width: 118rpx;
  height: 156rpx;
  border-radius: 10rpx;
  background-image: linear-gradient(135deg, #4c9a50 0%, #2a5f2d 100%);
  color: #ffffff;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.item-body {
  flex: 1;
  min-width: 0;
  padding-left: 20rpx;
}

.item-title {
  font-size: 29rpx;
  font-weight: 600;
  color: #1f2328;
  line-height: 1.4;
  padding-right: 84rpx;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.item-meta {
  font-size: 21rpx;
  color: #9aa0a6;
  margin-top: 8rpx;
}

.item-tags {
  display: flex;
  margin-top: 10rpx;
}

.item-tags .tag {
  margin-right: 10rpx;
}

.item-price-row {
  display: flex;
  align-items: baseline;
  margin-top: 10rpx;
}

.item-price {
  font-size: 36rpx;
  font-weight: 700;
  color: #e2453c;
}

.item-origin {
  font-size: 21rpx;
  color: #b3b8bd;
  text-decoration: line-through;
  margin-left: 12rpx;
}

.item-status {
  position: absolute;
  top: 0;
  right: 0;
  font-size: 20rpx;
  color: #9aa0a6;
  background-color: #f4f6f4;
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
}

/* -------- 底部操作 -------- */
.item-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f2f4f2;
}

.item-views {
  font-size: 21rpx;
  color: #b3b8bd;
}

.item-actions {
  display: flex;
  align-items: center;
}

.mini-btn {
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 28rpx;
  border-radius: 28rpx;
  background-color: #f4f6f4;
  color: #4a5055;
  font-size: 24rpx;
  margin-left: 14rpx;
  border: none;
}

.mini-btn::after {
  border: none;
}

.mini-btn-primary {
  background-color: #e8f3e9;
  color: #2f7d32;
  font-weight: 500;
}

/* -------- 空态 -------- */
.empty-wrap {
  padding: 120rpx 60rpx 40rpx;
  text-align: center;
}

.empty-ill {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  height: 150rpx;
  margin-bottom: 26rpx;
}

.empty-book {
  width: 54rpx;
  border-radius: 6rpx;
  background-color: #e8f3e9;
  border: 2rpx solid #d7e8d9;
}

.b1 {
  height: 110rpx;
}

.b2 {
  height: 138rpx;
  margin: 0 14rpx;
  background-color: #dcecdf;
}

.b3 {
  height: 96rpx;
}

.empty-text {
  font-size: 25rpx;
  color: #9aa0a6;
  line-height: 1.6;
}

.empty-btn {
  display: inline-block;
  margin-top: 28rpx;
  height: 76rpx;
  line-height: 76rpx;
  padding: 0 56rpx;
  border-radius: 38rpx;
  background-image: linear-gradient(135deg, #4c9a50 0%, #2f7d32 100%);
  color: #ffffff;
  font-size: 27rpx;
}
