<view class="page">

  <!-- 类型切换 -->
  <view class="tabs">
    <view
      class="tab {{tabIndex === index ? 'tab-on' : ''}}"
      wx:for="{{tabs}}"
      wx:key="key"
      bindtap="onTab"
      data-index="{{index}}"
    >{{item.label}}</view>
  </view>

  <view class="skeleton" wx:if="{{loading}}">
    <view class="sk-row"></view>
    <view class="sk-row"></view>
  </view>

  <block wx:if="{{!loading && list.length > 0}}">
    <view class="item" wx:for="{{list}}" wx:key="id">
      <view class="item-main" bindtap="goDetail" data-id="{{item.id}}">
        <view class="item-cover">书</view>
        <view class="item-body">
          <view class="item-title">{{item.title}}</view>
          <view class="item-meta">{{item.edition}}</view>
          <view class="item-tags">
            <text class="tag tag-green">{{item.conditionText}}</text>
            <text class="tag tag-gray" wx:if="{{item.dorm}}">{{item.dorm}}</text>
          </view>
          <view class="item-price-row">
            <text class="item-price">¥{{item.priceText}}</text>
            <text class="item-origin" wx:if="{{item.originalText}}">原价 ¥{{item.originalText}}</text>
          </view>
        </view>
        <view class="item-status">{{item.statusText}}</view>
      </view>
      <view class="item-foot">
        <text class="item-views">{{item.viewCount}} 人看过</text>
        <view class="item-actions">
          <button class="mini-btn" open-type="share" data-index="{{index}}" bindtap="onShare">分享</button>
          <view class="mini-btn mini-btn-primary" bindtap="goDetail" data-id="{{item.id}}">查看</view>
        </view>
      </view>
    </view>
  </block>

  <view class="empty-wrap" wx:if="{{!loading && list.length === 0}}">
    <view class="empty-ill">
      <view class="empty-book b1"></view>
      <view class="empty-book b2"></view>
      <view class="empty-book b3"></view>
    </view>
    <view class="empty-text">{{emptyText}}</view>
    <view class="empty-btn" bindtap="goPublish">去卖书</view>
  </view>

  <view class="safe-bottom"></view>
</view>
