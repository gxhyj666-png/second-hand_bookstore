.hero {
  background-image: linear-gradient(160deg, #2f7d32 0%, #27682a 100%);
  padding: 16rpx 32rpx 40rpx;
  border-bottom-left-radius: 32rpx;
  border-bottom-right-radius: 32rpx;
}

.hero-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.hero-school {
  font-size: 36rpx;
  font-weight: 600;
  color: #ffffff;
  letter-spacing: 1rpx;
}

.hero-arrow {
  font-size: 30rpx;
  opacity: 0.7;
  margin-left: 8rpx;
}

.hero-sub {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.72);
  margin-top: 6rpx;
}

.hero-bell {
  position: relative;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.16);
  display: flex;
  align-items: center;
  justify-content: center;
}

.bell-ico {
  font-size: 32rpx;
  color: #ffffff;
}

.bell-dot {
  position: absolute;
  top: 2rpx;
  right: 0;
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 6rpx;
  border-radius: 15rpx;
  background-color: #ff6b5e;
  color: #ffffff;
  font-size: 18rpx;
  line-height: 30rpx;
  text-align: center;
}

.search {
  margin-top: 24rpx;
  height: 84rpx;
  border-radius: 42rpx;
  background-color: #ffffff;
  display: flex;
  align-items: center;
  padding: 0 12rpx 0 28rpx;
}

.search-ico {
  font-size: 32rpx;
  color: #2f7d32;
  margin-right: 12rpx;
}

.search-ph {
  flex: 1;
  font-size: 26rpx;
  color: #a4a9ae;
}

.search-scan {
  height: 60rpx;
  padding: 0 24rpx;
  border-radius: 30rpx;
  background-color: #e8f3e9;
  color: #2f7d32;
  font-size: 24rpx;
  display: flex;
  align-items: center;
}

.hero-tip {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.6);
  margin-top: 16rpx;
  padding-left: 8rpx;
}

/* -------- 快捷入口 -------- */
.quick {
  display: flex;
  background-color: #ffffff;
  margin: -24rpx 24rpx 0;
  padding: 24rpx 12rpx;
  border-radius: 20rpx;
  position: relative;
  z-index: 2;
  box-shadow: 0 6rpx 20rpx rgba(31, 40, 32, 0.06);
}

.quick-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.quick-ico {
  width: 72rpx;
  height: 72rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #ffffff;
}

.quick-ico-1 {
  background-image: linear-gradient(135deg, #4c9a50 0%, #2f7d32 100%);
}

.quick-ico-2 {
  background-image: linear-gradient(135deg, #4f86c6 0%, #2f6bb5 100%);
}

.quick-ico-3 {
  background-image: linear-gradient(135deg, #d9a13f 0%, #b07a1f 100%);
}

.quick-ico-4 {
  background-image: linear-gradient(135deg, #8f6fb0 0%, #6b4b8c 100%);
}

.quick-label {
  font-size: 22rpx;
  color: #4a5055;
  margin-top: 12rpx;
}

/* -------- 课程横滑 -------- */
.course-scroll {
  white-space: nowrap;
  padding: 4rpx 0 8rpx;
}

.course-card {
  display: inline-block;
  vertical-align: top;
  white-space: normal;
  width: 400rpx;
  margin-left: 24rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  background-color: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(31, 35, 40, 0.04);
}

.course-card:first-child {
  margin-left: 24rpx;
}

.course-scroll-pad {
  display: inline-block;
  width: 8rpx;
  height: 1rpx;
}

.course-code {
  display: inline-block;
  font-size: 18rpx;
  color: #2f7d32;
  background-color: #e8f3e9;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
}

.course-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2328;
  margin-top: 12rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.course-meta {
  font-size: 22rpx;
  color: #9aa0a6;
  margin-top: 8rpx;
}

.course-book {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx dashed #eef0ee;
}

.course-book-tag {
  font-size: 18rpx;
  color: #a8710a;
  background-color: #fdf3e0;
  border-radius: 6rpx;
  padding: 2rpx 8rpx;
  margin-right: 10rpx;
  flex-shrink: 0;
}

.course-book-name {
  font-size: 22rpx;
  color: #4a5055;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.course-book-none {
  font-size: 22rpx;
  color: #b3b8bd;
}

.list {
  padding-bottom: 8rpx;
}
