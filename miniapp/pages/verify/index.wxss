.desk {
  background-image: linear-gradient(150deg, #2f7d32 0%, #245c27 100%);
  padding: 36rpx 32rpx 40rpx;
  color: #ffffff;
}

.desk-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.desk-title {
  font-size: 38rpx;
  font-weight: 600;
}

.desk-point {
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.75);
  margin-top: 8rpx;
}

.desk-count {
  text-align: right;
}

.desk-num {
  font-size: 56rpx;
  font-weight: 700;
  line-height: 1;
  font-family: "SF Mono", Menlo, Consolas, monospace;
}

.desk-unit {
  font-size: 21rpx;
  color: rgba(255, 255, 255, 0.72);
  margin-top: 6rpx;
}

.desk-tip {
  margin-top: 26rpx;
  font-size: 21rpx;
  color: rgba(255, 255, 255, 0.66);
  line-height: 1.6;
}

/* -------- 扫码区 -------- */
.scan-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 36rpx 0 12rpx;
}

.scan-icon {
  width: 132rpx;
  height: 132rpx;
  position: relative;
  margin-bottom: 22rpx;
}

.scan-corner {
  position: absolute;
  width: 32rpx;
  height: 32rpx;
  border: 4rpx solid #2f7d32;
}

.scan-tl {
  top: 0;
  left: 0;
  border-right: none;
  border-bottom: none;
  border-top-left-radius: 8rpx;
}

.scan-tr {
  top: 0;
  right: 0;
  border-left: none;
  border-bottom: none;
  border-top-right-radius: 8rpx;
}

.scan-bl {
  bottom: 0;
  left: 0;
  border-right: none;
  border-top: none;
  border-bottom-left-radius: 8rpx;
}

.scan-br {
  bottom: 0;
  right: 0;
  border-left: none;
  border-top: none;
  border-bottom-right-radius: 8rpx;
}

.scan-line {
  position: absolute;
  left: 10rpx;
  right: 10rpx;
  top: 62rpx;
  height: 3rpx;
  background-color: #2f7d32;
  opacity: 0.55;
}

.scan-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #2f7d32;
}

.scan-sub {
  font-size: 21rpx;
  color: #9aa0a6;
  margin-top: 8rpx;
}

/* -------- 表单 -------- */
.code-input {
  letter-spacing: 8rpx;
  font-family: "SF Mono", Menlo, Consolas, monospace;
  font-size: 32rpx;
  font-weight: 600;
}

.submit-btn {
  margin-top: 26rpx;
}

.mock-tip {
  margin-top: 16rpx;
  font-size: 21rpx;
  color: #a8710a;
  background-color: #fdf3e0;
  border-radius: 10rpx;
  padding: 12rpx 16rpx;
  line-height: 1.6;
}

/* -------- 记录 -------- */
.rec {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #eef0ee;
}

.rec:last-child {
  border-bottom: none;
}

.rec-cover {
  width: 74rpx;
  height: 98rpx;
  border-radius: 8rpx;
  background-image: linear-gradient(135deg, #4c9a50 0%, #2a5f2d 100%);
  color: #ffffff;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.rec-body {
  flex: 1;
  min-width: 0;
  padding: 0 18rpx;
}

.rec-title {
  font-size: 27rpx;
  color: #1f2328;
  font-weight: 500;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.rec-meta {
  font-size: 20rpx;
  color: #9aa0a6;
  margin-top: 8rpx;
}

.rec-right {
  text-align: right;
  flex-shrink: 0;
}

.rec-amount {
  font-size: 27rpx;
  font-weight: 600;
  color: #e2453c;
}

.rec-time {
  font-size: 20rpx;
  color: #b3b8bd;
  margin-top: 8rpx;
}

/* -------- 空态 -------- */
.empty-hint {
  text-align: center;
  padding: 44rpx 24rpx;
}

.empty-title {
  font-size: 27rpx;
  color: #4a5055;
  font-weight: 500;
}

.empty-sub {
  font-size: 22rpx;
  color: #9aa0a6;
  margin-top: 10rpx;
  line-height: 1.6;
}
