/* -------- 状态横幅 -------- */
.banner {
  background-image: linear-gradient(150deg, #2f7d32 0%, #27682a 100%);
  padding: 36rpx 32rpx 56rpx;
  color: #ffffff;
}

.banner-status {
  font-size: 40rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.banner-hint {
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.78);
  margin-top: 12rpx;
  line-height: 1.6;
}

/* -------- 核销码 -------- */
.code-card {
  margin: -32rpx 24rpx 0;
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx 24rpx 24rpx;
  text-align: center;
  box-shadow: 0 8rpx 28rpx rgba(31, 40, 32, 0.1);
  position: relative;
  z-index: 2;
}

.code-label {
  font-size: 24rpx;
  color: #8a9096;
  letter-spacing: 2rpx;
}

.code-value {
  font-size: 76rpx;
  font-weight: 700;
  color: #1f2328;
  letter-spacing: 16rpx;
  line-height: 1.3;
  margin: 12rpx 0 4rpx;
  font-family: "SF Mono", Menlo, Consolas, monospace;
  text-indent: 16rpx;
}

.code-tip {
  font-size: 25rpx;
  color: #2f7d32;
  font-weight: 500;
}

.code-timer {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 16rpx;
  background-color: #f7f9f7;
  border-radius: 12rpx;
  padding: 12rpx 0;
}

.timer-num {
  font-size: 26rpx;
  font-weight: 600;
  color: #a8710a;
  font-family: "SF Mono", Menlo, Consolas, monospace;
  margin-right: 10rpx;
}

.timer-text {
  font-size: 21rpx;
  color: #8a9096;
}

.code-refresh {
  margin-top: 18rpx;
  font-size: 23rpx;
  color: #2f6bb5;
}

/* -------- 通用 -------- */
.goods {
  display: flex;
}

.goods-cover {
  width: 110rpx;
  height: 146rpx;
  border-radius: 10rpx;
  background-image: linear-gradient(135deg, #4c9a50 0%, #2a5f2d 100%);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.goods-body {
  flex: 1;
  min-width: 0;
  padding-left: 20rpx;
}

.goods-title {
  font-size: 29rpx;
  font-weight: 600;
  color: #1f2328;
  line-height: 1.4;
}

.goods-meta {
  font-size: 22rpx;
  color: #8a9096;
  margin-top: 8rpx;
}

.goods-price {
  font-size: 32rpx;
  font-weight: 700;
  color: #e2453c;
  margin-top: 10rpx;
}

.point-name {
  font-size: 29rpx;
  font-weight: 500;
  color: #1f2328;
}

.point-addr {
  font-size: 23rpx;
  color: #8a9096;
  margin-top: 8rpx;
}

.point-time {
  font-size: 22rpx;
  color: #a4a9ae;
  margin-top: 6rpx;
}

/* -------- 支付 -------- */
.pay-box {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0 16rpx;
}

.pay-amount {
  font-size: 52rpx;
  font-weight: 700;
  color: #e2453c;
}

.pay-btn {
  min-width: 220rpx;
  height: 80rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
}

.pay-note {
  font-size: 22rpx;
  color: #a4a9ae;
  line-height: 1.6;
}

/* -------- 时间轴 -------- */
.timeline {
  padding: 4rpx 0 0;
}

.tl-item {
  display: flex;
}

.tl-axis {
  width: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
}

.tl-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background-color: #dfe3e0;
  margin-top: 10rpx;
}

.tl-dot-on {
  background-color: #2f7d32;
  box-shadow: 0 0 0 6rpx rgba(47, 125, 50, 0.12);
}

.tl-line {
  flex: 1;
  width: 2rpx;
  background-color: #eef0ee;
  margin: 6rpx 0;
  min-height: 32rpx;
}

.tl-body {
  flex: 1;
  padding: 0 0 24rpx 8rpx;
}

.tl-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.tl-label {
  font-size: 26rpx;
  color: #a4a9ae;
}

.tl-label-on {
  color: #1f2328;
  font-weight: 500;
}

.tl-time {
  font-size: 21rpx;
  color: #b3b8bd;
}

.tl-desc {
  font-size: 22rpx;
  color: #a4a9ae;
  margin-top: 6rpx;
  line-height: 1.5;
}

/* -------- 信息 -------- */
.copy {
  font-size: 22rpx;
  color: #2f7d32;
}

.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
}

.info-k {
  font-size: 25rpx;
  color: #8a9096;
}

.info-v {
  font-size: 25rpx;
  color: #1f2328;
  max-width: 460rpx;
  text-align: right;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* -------- 评价 -------- */
.stars {
  display: flex;
  padding: 8rpx 0 16rpx;
}

.star {
  font-size: 56rpx;
  color: #e2e5e2;
  margin-right: 16rpx;
  line-height: 1;
}

.star-on {
  color: #f0a92c;
}

.stars-static {
  display: flex;
  margin-bottom: 12rpx;
}

.star-static {
  font-size: 30rpx;
  color: #e2e5e2;
  margin-right: 6rpx;
}

.review-label {
  font-size: 25rpx;
  color: #6b7075;
}

.review-input {
  width: 100%;
  height: 150rpx;
  background-color: #f5f7f5;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 26rpx;
}

.ph {
  color: #a4a9ae;
  font-size: 25rpx;
}

.anon-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0 8rpx;
}

.anon-label {
  font-size: 25rpx;
  color: #4a5055;
}

.review-btn {
  height: 80rpx;
  border-radius: 40rpx;
  margin-top: 12rpx;
  font-size: 28rpx;
}

.review-text {
  font-size: 26rpx;
  color: #4a5055;
  line-height: 1.7;
}

.review-todo {
  font-size: 24rpx;
  color: #a4a9ae;
}

/* -------- 底栏 -------- */
.bar-hint {
  flex: 1;
  display: flex;
  align-items: baseline;
  padding-left: 8rpx;
}

.bar-hint-k {
  font-size: 22rpx;
  color: #8a9096;
  margin-right: 8rpx;
}

.bar-hint-v {
  font-size: 36rpx;
  font-weight: 700;
  color: #e2453c;
}

.bar-actions {
  display: flex;
  align-items: center;
}

.bar-actions .btn + .btn {
  margin-left: 16rpx;
}
