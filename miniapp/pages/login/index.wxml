<view class="page login-page">

  <!-- 品牌 -->
  <view class="brand">
    <view class="logo">书</view>
    <view class="brand-name">同窗书</view>
    <view class="brand-slogan">按课表找教材，让一本书在一届届同学之间继续流转</view>
  </view>

  <!-- 切换 -->
  <view class="mode">
    <view class="mode-item {{mode === 'login' ? 'mode-on' : ''}}" bindtap="onMode" data-mode="login">登录</view>
    <view class="mode-item {{mode === 'register' ? 'mode-on' : ''}}" bindtap="onMode" data-mode="register">注册</view>
  </view>

  <!-- 登录表单 -->
  <view class="form" wx:if="{{mode === 'login'}}">
    <view class="field">
      <view class="field-label">账号 / 手机号</view>
      <input
        class="field-input"
        value="{{account}}"
        placeholder="演示账号 buyer001"
        placeholder-class="ph"
        maxlength="32"
        bindinput="onField"
        data-field="account"
      />
    </view>
    <view class="field">
      <view class="field-label">密码</view>
      <view class="pwd-row">
        <input
          class="field-input pwd-input"
          value="{{password}}"
          password="{{!showPassword}}"
          placeholder="请输入密码"
          placeholder-class="ph"
          maxlength="32"
          bindinput="onField"
          data-field="password"
        />
        <text class="pwd-toggle" bindtap="togglePassword">{{showPassword ? '隐藏' : '显示'}}</text>
      </view>
    </view>
  </view>

  <!-- 注册表单 -->
  <view class="form" wx:else>
    <view class="field">
      <view class="field-label">手机号</view>
      <input
        class="field-input"
        value="{{phone}}"
        type="number"
        placeholder="11 位手机号，用于找书通知"
        placeholder-class="ph"
        maxlength="11"
        bindinput="onField"
        data-field="phone"
      />
    </view>
    <view class="field">
      <view class="field-label">昵称</view>
      <input
        class="field-input"
        value="{{nickname}}"
        placeholder="同学们看到的名字，如 小黄同学"
        placeholder-class="ph"
        maxlength="16"
        bindinput="onField"
        data-field="nickname"
      />
    </view>
    <view class="field">
      <view class="field-label">设置密码</view>
      <view class="pwd-row">
        <input
          class="field-input pwd-input"
          value="{{password}}"
          password="{{!showPassword}}"
          placeholder="至少 6 位"
          placeholder-class="ph"
          maxlength="32"
          bindinput="onField"
          data-field="password"
        />
        <text class="pwd-toggle" bindtap="togglePassword">{{showPassword ? '隐藏' : '显示'}}</text>
      </view>
    </view>
  </view>

  <view class="agree-row" bindtap="onAgree">
    <view class="checkbox {{agree ? 'checkbox-on' : ''}}"></view>
    <view class="agree-text">我已阅读并同意<text class="link" bindtap="onAgreement">《用户协议与隐私说明》</text></view>
  </view>

  <view class="btn btn-primary btn-block submit" bindtap="onSubmit">
    {{submitting ? '请稍候…' : (mode === 'login' ? '登录' : '注册并登录')}}
  </view>

  <!-- 演示账号 -->
  <view class="demo" wx:if="{{mode === 'login'}}">
    <view class="demo-title">演示账号（密码均为 123456）</view>
    <view class="demo-list">
      <view
        class="demo-item"
        wx:for="{{demos}}"
        wx:key="account"
        bindtap="fillDemo"
        data-account="{{item.account}}"
      >
        <view class="demo-account">{{item.account}}</view>
        <view class="demo-label">{{item.label}}</view>
      </view>
    </view>
  </view>

  <view class="foot-tip">登录即表示你将遵守校内二手交易规范，不发布盗版与违规教材</view>

</view>
